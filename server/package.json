    "express-jwt": "^8.5.1",
    "express-rate-limit": "^8.7.4",
    "file-type": "^22.3.0",
    "isomorphic-dompurify": "^4.8.0",
    "mongoose": "^9.12.2",
    "multer": "^2.5.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
