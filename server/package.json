    "express-jwt": "^8.5.1",
    "express-rate-limit": "^8.6.2",
    "file-type": "^22.0.1",
    "isomorphic-dompurify": "^3.22.0",
    "mongoose": "^9.9.2",
    "multer": "^2.2.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
